{
  "name": "customer-return-server",
  "version": "0.1.0",
  "private": true,
  "description": "The Customer Return example: a custom app backend on Vercel that verifies storefront-forwarded requests with @commercebuild/app-server.",
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "next build",
    "start": "next start -p 4000",
    "migrate": "node --experimental-strip-types scripts/migrate.mts",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@commercebuild/app-server": "^0.1.1",
    "@commercebuild/platform-api": "0.11.33",
    "next": "16.3.8",
    "postgres": "3.4.9",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "22.18.10",
    "@types/react": "19.2.2",
    "jose": "6.1.3",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=22"
  }
}
